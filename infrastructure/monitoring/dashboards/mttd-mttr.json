{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "MTTD / MTTR SLO — Incident Response Copilot",
  "description": "Mean Time to Detect and Mean Time to Recovery SLO tracking (spec 06 §4, ADR-0015)",
  "tags": ["mttd", "mttr", "slo", "adr-0015"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "MTTD — p50 / p90 / p99 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(incident_mttd_seconds_bucket[1h]))",
          "legendFormat": "p50 MTTD"
        },
        {
          "expr": "histogram_quantile(0.90, rate(incident_mttd_seconds_bucket[1h]))",
          "legendFormat": "p90 MTTD"
        },
        {
          "expr": "histogram_quantile(0.99, rate(incident_mttd_seconds_bucket[1h]))",
          "legendFormat": "p99 MTTD"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 300, "color": "yellow" },
              { "value": 600, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "MTTR — p50 / p75 / p90 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(incident_mttr_seconds_bucket[1h]))",
          "legendFormat": "p50 MTTR"
        },
        {
          "expr": "histogram_quantile(0.75, rate(incident_mttr_seconds_bucket[1h]))",
          "legendFormat": "p75 MTTR"
        },
        {
          "expr": "histogram_quantile(0.90, rate(incident_mttr_seconds_bucket[1h]))",
          "legendFormat": "p90 MTTR"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1800, "color": "yellow" },
              { "value": 3600, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Incident Count by Severity",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(incidents_total[24h])) by (severity)",
          "legendFormat": "{{ severity }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "30-day Error Budget Remaining",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "1 - clamp_min((sum(increase(http_requests_total{status=~\"5..\"}[30d])) / sum(increase(http_requests_total[30d]))) / (1 - 0.999), 0)",
          "legendFormat": "Error Budget"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.25, "color": "yellow" },
              { "value": 0.5, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Corpus Baseline vs Copilot MTTD (research comparison)",
      "description": "Overlays corpus MTTD baselines from papers P01–P12 for quantitative comparison (RULE-002, spec 06 §4.2)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(incident_mttd_seconds_bucket[24h]))",
          "legendFormat": "Copilot p50 MTTD"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
